<?xml version="1.0" encoding="utf-8"?>

<!-- CasparCG config for protocol verification under emulation.

     720p2500 rather than 1080p5000 on purpose: this guest is fully emulated,
     and halving the frame rate and pixel count buys headroom for the thing we
     actually care about — the server staying responsive on AMCP while it
     renders. Geometry checks do not need resolution.

     No consumers are configured. 2.5.0 only produces mixed frames on channels
     that have one, so consumers get added over AMCP when a test needs them
     (`ADD 1 FILE …`), and `PRINT` acts as a one-shot consumer for stills. -->
<configuration>
    <paths>
        <media-path>/opt/caspar/media/</media-path>
        <log-path disable="false">/opt/caspar/log/</log-path>
        <data-path>/opt/caspar/data/</data-path>
        <template-path>/opt/caspar/template/</template-path>
    </paths>
    <lock-clear-phrase>secret</lock-clear-phrase>
    <log-level>debug</log-level>
    <channels>
        <channel>
            <video-mode>720p2500</video-mode>
            <consumers>
            </consumers>
        </channel>
        <channel>
            <video-mode>720p2500</video-mode>
            <consumers>
            </consumers>
        </channel>
    </channels>
    <controllers>
        <tcp>
            <port>5250</port>
            <protocol>AMCP</protocol>
        </tcp>
    </controllers>
    <osc>
        <default-port>6250</default-port>
        <!-- Left enabled deliberately: this is the behaviour caspar-AV's
             fallback path relies on, so it should be exercised too. -->
        <disable-send-to-amcp-clients>false</disable-send-to-amcp-clients>
    </osc>
    <amcp>
        <media-server>
            <host>localhost</host>
            <port>8000</port>
        </media-server>
    </amcp>
</configuration>
